# ─── Environment Variables ────────────────────────────────────────────────────
# NEVER commit .env files — they contain real secrets
.env
.env.local
# .env.production is intentionally NOT ignored for frontend — it only contains
# the safe relative API path (REACT_APP_API_URL=/api) needed at build time.
# backend/.env.production (with real secrets) is covered by backend/.gitignore
.env.development.local
.env.test.local
.env.production.local

# ─── Dependencies ─────────────────────────────────────────────────────────────
node_modules/
**/node_modules/

# ─── Build output ─────────────────────────────────────────────────────────────
frontend/build/
dist/

# ─── Logs ─────────────────────────────────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ─── Runtime ──────────────────────────────────────────────────────────────────
pids/
*.pid
*.seed

# ─── OS ───────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ─── Editor ───────────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo

# ─── Coverage ─────────────────────────────────────────────────────────────────
coverage/
.nyc_output/
